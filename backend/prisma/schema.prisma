// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(100)
  password String @db.VarChar(255)

  @@map("users")
}

enum QuantityUnit {
  g
  ml
  u
}

model Product {
  id                Int           @id @default(autoincrement())
  barcode           String        @db.VarChar(64)
  name              String?       @db.VarChar(255)
  photoUrl          String?       @db.VarChar(500)
  description       String        @db.VarChar(500)
  category          String        @db.VarChar(100)
  expirationDate    DateTime      @db.Date
  quantityAmount    Float?
  quantityUnit      QuantityUnit?
  quantityRemaining Int           @db.TinyInt
  price             Float?
  comment           String?       @db.VarChar(1000)
  createdAt         DateTime      @default(now())

  genericProductId Int?
  genericProduct   GenericProduct? @relation(fields: [genericProductId], references: [id])

  @@map("products")
}

model GenericProduct {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  products          Product[]
  recipeIngredients RecipeIngredient[]

  @@map("generic_products")
}

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  photoUrl    String?  @db.VarChar(500)
  servings    Int?     @db.TinyInt
  createdAt   DateTime @default(now())

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id             Int          @id @default(autoincrement())
  quantityAmount Float
  quantityUnit   QuantityUnit

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  genericProductId Int
  genericProduct   GenericProduct @relation(fields: [genericProductId], references: [id])

  @@map("recipe_ingredients")
}
