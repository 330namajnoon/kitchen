{
  "name": "kitchen-backend",
  "packageManager": "yarn@4.9.1",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pm2:start": "yarn build && pm2 start ecosystem.config.js --only kitchen-backend",
    "pm2:start:prod": "yarn build && pm2 start ecosystem.config.js --only kitchen-backend --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --only kitchen-backend-dev",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "yarn build && pm2 restart ecosystem.config.js --only kitchen-backend",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs kitchen-backend",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "sm-express-server": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^7.9.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "5.7.3"
  }
}
