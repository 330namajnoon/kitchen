// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(100)
  password String @db.VarChar(255)

  @@map("users")
}

enum QuantityUnit {
  g
  ml
  u
  tsp
  tbsp
  pinch
  cup
}

enum ShoppingListStatus {
  pending
  completed
}

model Product {
  id                Int           @id @default(autoincrement())
  barcode           String        @db.VarChar(64)
  name              String?       @db.VarChar(255)
  photoUrl          String?       @db.VarChar(500)
  description       String        @db.VarChar(500)
  category          String        @db.VarChar(100)
  quantityAmount    Float?
  quantityUnit      QuantityUnit?
  price             Float?
  comment           String?       @db.VarChar(1000)
  createdAt         DateTime      @default(now())

  genericProductId Int?
  genericProduct   GenericProduct? @relation(fields: [genericProductId], references: [id])

  availableProducts AvailableProduct[]

  @@map("products")
}

model AvailableProduct {
  id                  Int       @id @default(autoincrement())
  quantity            Int       @default(1)
  percentageRemaining Int       @default(100)
  expirationDate      DateTime? @db.Date
  createdAt           DateTime  @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("available_products")
}

model GenericProduct {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  products          Product[]
  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]

  @@map("generic_products")
}

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  photoUrl    String?  @db.VarChar(500)
  servings    Int?     @db.TinyInt
  createdAt   DateTime @default(now())

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id             Int          @id @default(autoincrement())
  quantityAmount Float
  quantityUnit   QuantityUnit

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  genericProductId Int
  genericProduct   GenericProduct @relation(fields: [genericProductId], references: [id])

  @@map("recipe_ingredients")
}

model ShoppingList {
  id                    Int                @id @default(autoincrement())
  estimatedPurchaseDate DateTime           @db.Date
  status                ShoppingListStatus @default(pending)
  createdAt             DateTime           @default(now())

  items ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id             Int          @id @default(autoincrement())
  quantityAmount Float
  quantityUnit   QuantityUnit

  shoppingListId Int
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  genericProductId Int
  genericProduct   GenericProduct @relation(fields: [genericProductId], references: [id])

  @@map("shopping_list_items")
}
